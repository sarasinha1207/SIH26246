# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# ---- Editor / OS / local tooling ----
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# ---- Documents that are not part of the pipeline ----
*.pdf
*.docsx
*.pptx

# ---- Legacy dataset: never used for modelling (see README "Data rules") ----
Archived

# ---- Quarantined prototype outputs (never committed) ----
outputs/quarantine/provisional_prototype/*.csv
outputs/quarantine/provisional_prototype/*.json
reports/quarantine/**/*.csv
reports/quarantine/**/*.json

# ---- Regenerable data (rebuild with the scripts in README.md) ----
# split_manifest.json is tracked: its checksums prove a rebuilt split file is identical.
data/splits/*.parquet
data/interim/*
!data/interim/.gitkeep
data/fresh_draws/
reports/evaluation/v3/**/*.npy
LGD_Districts.parquet
*.db
*.tmp

# ---- File-level backup snapshots (git tags are the version-controlled safety net) ----
backups/

# NOTE: *.csv, *.json and data/ used to be ignored wholesale, which hid configs, manifests, reports and
# model inputs that must be committed. Only the large regenerable files above are ignored now.
