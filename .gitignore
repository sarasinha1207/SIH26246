# =====================================================================================================================
# KaushalSetu - what stays out of git.  Anything regenerable, local, secret or machine-specific is listed here.
# =====================================================================================================================

# ---- Secrets and local configuration: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
.vercel/
.claude/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
ENV/
.Python
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Editors and operating systems ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Logs and temporary output ----
*.log
*.tmp
*.temp
*.bak
*.orig

# ---- Documents that are not part of the pipeline (slides, reports) ----
*.pdf
*.pptx
*.docx
*.docsx

# ---- Legacy dataset: never used for modelling (see README "Data rules"); kept on disk, not in git ----
Archived/

# ---- Previous versions and working documents: kept on disk, not in the repository ----
# Nothing below is read by the website, the monthly forecast (src/deployment) or the data build; each is superseded, quarantined or a working write-up.
# (git does not allow a comment on the same line as a pattern, so each note sits above its rule.)
# the nine phase write-ups (working documents)
docs/phases/
# the original brief (and an identical copy that appeared in the project root)
PROBLEM_STATEMENT.md
# reference extract, not read by any script
docs/reference/NCO_CLASSIFICATION_HIERARCHY.md
# v1 synthetic dataset, replaced in Phase 2
data/superseded/
# v1 dataset generator
src/data_generation/legacy/
# Phase 7 models, replaced by xgboost_v3 (the live forecast uses models/deployed and models/xgboost_v3)
models/xgboost_v1/
# Phase 8 frozen models (xgboost_v3/primary carries the declared copy)
models/xgboost_v2/
# first feature-selection pass, replaced by the final feature sets
reports/features/pass1_with_time_proxies/
# the quarantined prototype: code, models, outputs and report (never to be used)
src/modeling/
quarantine/

# ---- Regenerable data (rebuild with the scripts in README.md) ----
# split_manifest.json is tracked: its checksums prove a rebuilt split file is identical.
data/splits/*.parquet
data/interim/*
!data/interim/.gitkeep
data/fresh_draws/
reports/evaluation/v3/**/*.npy
LGD_Districts.parquet
*.db

# External source files downloaded for the map outline (22 MB; the build script says how to fetch them again)
data/external/

# ---- File-level backup snapshots (git tags are the version-controlled safety net) ----
backups/

# NOTE: *.csv, *.json and data/ used to be ignored wholesale, which hid configs, manifests, reports and
# model inputs that must be committed. Only the large regenerable files above are ignored now.
# Never ignore: app/ (the website). The v3 forecast files (outputs/forecasts) are ignored now: the v4 website reads app/ only.

# ---- v4 (10 states, 25 trades, 2000-2025): large generated data is rebuilt from the seed; manifests and the district list are tracked ----
data/v4/raw/
data/v4/processed/
data/v4/splits/
data/v4/interim/
# v4 fitted models (rebuilt by src/v4/evaluate.py and src/v4/forecast.py); the tuned settings and the result tables in reports/v4/evaluation are tracked
models/v4/
# v4 phase 6: series-level forecast tables and per-state shards are rebuilt by src/v4/forecast.py, demand_index.py, capacity.py and exports.py (listed with SHA-256 in data/v4/FORECAST_MANIFEST.json)
data/v4/exports/*.parquet
data/v4/exports/shards/

# v4 phase 9: the v3 dashboard data file is not loaded by the v4 dashboard; it stays on disk (the submitted version is the tag submitted-v1) but is no longer deployed
app/dashboard/data/dash_data.js

# ---- v3 data and models: the submitted version is the tag submitted-v1; the v4 website and API read app/ only ----
# kept on disk, no longer in the repository (about 65 MB): the v3 raw tables, the v3 processed panel and dashboard pack, the v3 models and the v3 forecast files
data/raw/lmis_district_monthly_2011_2026.csv
data/raw/lmis_district_quarterly_2011_2026.csv
data/processed/*
!data/processed/.gitkeep
data/dashboard/
models/xgboost_v3/
models/deployed/
outputs/forecasts/
